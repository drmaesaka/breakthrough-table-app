# Every environment variable this app reads, and where each one has to be set.
#
# Copy to .env.local for local development. .env.local is gitignored and is NOT
# backed up anywhere — if that file is lost, the VAPID keys in particular cannot
# be recovered, and regenerating them silently kills every existing push
# subscription. Keep a copy somewhere safe.
#
# "Vercel" below means Settings → Environment Variables in the Vercel dashboard.
# Setting a variable there does not affect running deployments; you must redeploy.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle at build
# time and is visible to every visitor. Never put a secret behind that prefix.

# ---------------------------------------------------------------------------
# Supabase — the database and auth. Required; nothing works without these.
# ---------------------------------------------------------------------------

# Local + Vercel. Public.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Local + Vercel. Public by design — it grants nothing on its own, because Row
# Level Security is what constrains it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel ONLY. This key BYPASSES Row Level Security entirely: it can read and
# write every row in every table. It must never reach a browser, which is why it
# has no NEXT_PUBLIC_ prefix.
#
# NOTE: this is deliberately absent from .env.local today, which means every
# route under /api/admin/* fails locally. Set it locally only if you need to work
# on leader tooling, and never commit it.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Local + Vercel. Used to build absolute links in notifications.
NEXT_PUBLIC_APP_URL=https://breakthrough-table-app.vercel.app

# ---------------------------------------------------------------------------
# Web push — self-hosted VAPID, no vendor involved.
# ---------------------------------------------------------------------------
#
# Generate a pair with:  npx web-push generate-vapid-keys
# The public key is set twice, once server-side and once for the browser.
#
# ⚠️ Changing these invalidates every push subscription that already exists, and
# members have to re-enable notifications by hand. Treat as permanent.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Scheduler — the shared secret guarding the three notification endpoints.
# ---------------------------------------------------------------------------
#
# The same value must appear in FOUR places, or a cron job starts 401ing:
#   1. .env.local
#   2. Vercel
#   3. cron-job.org, as an "Authorization: Bearer <value>" header on each of the
#      three jobs (send-nudges, send-checkin, send-event-notices)
#   4. GitHub repository secrets, for the manual-dispatch workflow
#
# There is no rotation mechanism. Rotating it means editing all four by hand.
NUDGE_SECRET=

# ---------------------------------------------------------------------------
# Resend — transactional email. Currently DORMANT.
# ---------------------------------------------------------------------------
#
# lib/send-email.ts requires BOTH of these before it will send anything. With
# either missing it logs what it would have sent and returns success, which looks
# identical to working. No code change is needed to switch email on — only these
# two values.
#
# The DNS is already live under send.breakthroughtable.com. Never add Resend
# records to the root domain: breakthroughtable.com runs live Microsoft 365 mail
# with an SPF record ending in -all.

RESEND_API_KEY=
RESEND_FROM=Breakthrough Table <noreply@send.breakthroughtable.com>

# ---------------------------------------------------------------------------
# Cause Machine — read-only membership and payment records.
# ---------------------------------------------------------------------------
#
# Server-only, unprefixed deliberately: these credentials unlock the entire
# membership database including every email address.
#
# The API is read-only apart from webhook management. Generated in Cause Machine
# under Settings → Integrations → API.

CAUSE_MACHINE_APP_ID=
CAUSE_MACHINE_KEY=
